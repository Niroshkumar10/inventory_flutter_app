rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /inventory_images/{userMobile}/{fileName} {
      // Product photos aren't sensitive — readable by anyone with the URL.
      allow read: if true;
      // Any signed-in session (including the anonymous auth this app already
      // uses via ensureAuthUser()) can upload, capped at 10MB, images only.
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
